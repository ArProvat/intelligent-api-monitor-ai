    "pino": "^9.9.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.5",
    "@types/node": "^24.9.1",
    "typescript": "^5.9.3"
  }
}
